# Copy this file to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
# Optional: a test server id. Slash commands sync to it instantly instead of globally.
DEV_GUILD_ID=

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Taipei
BOT_LANGUAGE=Traditional Chinese (Taiwan)
DB_PATH=data/bot.db

# Memory window
RETENTION_DAYS=10
SUMMARY_LOOKBACK_DAYS=7
RECENT_MESSAGE_LIMIT=40

# ---------------------------------------------------------------------------
# Main model (answers questions)
# MAIN_PROVIDER: ollama | openai | azure
# ---------------------------------------------------------------------------
MAIN_PROVIDER=openai
# For azure, put the deployment name here, not the model name.
MAIN_MODEL=
MAIN_API_KEY=
# openai: leave empty for api.openai.com. ollama: default http://localhost:11434/v1
MAIN_BASE_URL=
# azure only
MAIN_AZURE_ENDPOINT=
MAIN_AZURE_API_VERSION=
# Optional. Some models only accept the default temperature; leave empty if unsure.
MAIN_TEMPERATURE=
MAIN_MAX_TOKENS=1024
MAIN_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Summary model (writes daily summaries)
# Production: SUMMARY_PROVIDER=ollama, SUMMARY_MODEL=qwen3:4b, SUMMARY_BASE_URL=http://localhost:11434
# Development without Ollama: use openai or azure and set SUMMARY_ALLOW_CLOUD=true.
# ---------------------------------------------------------------------------
SUMMARY_PROVIDER=openai
SUMMARY_MODEL=
SUMMARY_API_KEY=
# ollama: native API host WITHOUT /v1, default http://localhost:11434
SUMMARY_BASE_URL=
SUMMARY_AZURE_ENDPOINT=
SUMMARY_AZURE_API_VERSION=
SUMMARY_TEMPERATURE=
SUMMARY_MAX_TOKENS=
SUMMARY_TIMEOUT_SECONDS=300
# A cloud summary provider receives the full raw log of each day. Required to be true for openai/azure.
SUMMARY_ALLOW_CLOUD=true

# Context length passed to Ollama per call (ollama only).
SUMMARY_NUM_CTX=8192
# A day is split into chunks by message count and size before summarizing.
SUMMARY_CHUNK_MESSAGES=100
SUMMARY_CHUNK_CHARS=6000

# ---------------------------------------------------------------------------
# Background tasks
# ---------------------------------------------------------------------------
# Summarize a channel after it has been quiet this long...
SUMMARY_IDLE_MINUTES=30
# ...or during this local-time window, [start, end).
SUMMARY_OFFPEAK_START_HOUR=3
SUMMARY_OFFPEAK_END_HOUR=6
SUMMARY_SCAN_MINUTES=5
CLEANUP_INTERVAL_MINUTES=60
